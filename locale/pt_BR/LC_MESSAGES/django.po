#: templates/affiliates/email/affiliate_added.txt:12
msgid "Go live or record videos"
msgstr "Faça lives ou grave vídeos"

#: templates/affiliates/email/affiliate_added.html:14
#: templates/affiliates/email/affiliate_added.txt:12
msgid ""
"Explain the product, show the screens and answer questions, with the link in "
"the description or in the comments."
msgstr ""
"Explique o produto, mostre as telas e tire dúvidas, com o link na descrição "
"ou nos comentários."

#: templates/affiliates/email/affiliate_added.html:15
#: templates/affiliates/email/affiliate_added.txt:13
msgid "Run ads"
msgstr "Faça anúncios"

#: templates/affiliates/email/affiliate_added.html:15
#: templates/affiliates/email/affiliate_added.txt:13
msgid ""
"You can advertise on Instagram, Facebook, Google or wherever your audience "
"is, pointing the ad to your link."
msgstr ""
"Você pode anunciar no Instagram, no Facebook, no Google ou onde seu público "
"estiver, apontando o anúncio para o seu link."

#: templates/affiliates/email/affiliate_added.html:16
#: templates/affiliates/email/affiliate_added.txt:14
msgid "Write about it"
msgstr "Escreva sobre ele"

#: templates/affiliates/email/affiliate_added.html:16
#: templates/affiliates/email/affiliate_added.txt:14
msgid ""
"An article, a newsletter or a tutorial with the link keeps bringing people "
