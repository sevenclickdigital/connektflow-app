msgid "Photo must be at least 180×180 pixels."
msgstr "A foto deve ter no mínimo 180×180 pixels."

#: apps/accounts/views.py:194
msgid "Could not read image file."
msgstr "Não foi possível ler o arquivo de imagem."

#: apps/accounts/views.py:206
msgid "Photo updated."
msgstr "Foto atualizada."

#: apps/accounts/views.py:216
msgid "Current password is required."
msgstr "A senha atual é obrigatória."

#: apps/accounts/views.py:220
msgid "Current password is incorrect."
msgstr "A senha atual está incorreta."

