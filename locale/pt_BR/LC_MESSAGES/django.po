msgid ""
"The apps connected to your account were disconnected. Authorize them again "
"to keep using them."
msgstr ""
"Os aplicativos conectados à sua conta foram desconectados. Autorize-os "
"novamente para continuar usando."

#: apps/accounts/views.py:291
#, python-format
msgid ""
"You are the sole owner of: %(orgs)s. Transfer ownership or delete the "
"organization before deleting your account."
msgstr ""
"Você é o único proprietário de: %(orgs)s. Transfira a propriedade ou exclua "
"a organização antes de excluir sua conta."

#: apps/accounts/views.py:301
msgid "Your account has been deleted."
msgstr "Sua conta foi excluída."

#: apps/accounts/views.py:322
msgid "You are signed in"
msgstr "Você entrou"

#: apps/accounts/views.py:338
msgid "You must agree to the Terms of Service and Privacy Policy to continue."
msgstr ""
"Você precisa aceitar os Termos de Serviço e a Política de Privacidade para "
"continuar."

#: apps/accounts/views_impersonation.py:65
#, python-format
msgid ""
"You are now using %(email)s's account. Everything you do happens as them."
msgstr ""
"Você está usando a conta de %(email)s. Tudo o que você fizer acontece como "
"essa pessoa."

#: apps/accounts/views_impersonation.py:91
msgid "Your operator session has ended. Please sign in again."
msgstr "Sua sessão de operador foi encerrada. Entre novamente."

#: apps/accounts/views_impersonation.py:95
msgid "You are back in your own account."
msgstr "Você voltou para sua própria conta."

