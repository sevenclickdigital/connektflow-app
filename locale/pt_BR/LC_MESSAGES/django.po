#: templates/affiliates/email/affiliate_added.txt:10
msgid ""
"By WhatsApp, e-mail or in a conversation: a recommendation from someone they "
"know is what converts best."
msgstr ""
"Por WhatsApp, e-mail ou numa conversa: a indicação de alguém conhecido é a "
"que mais converte."

