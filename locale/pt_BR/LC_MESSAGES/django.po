#: apps/accounts/staff_views.py:68
msgid "Enter a valid e-mail address."
msgstr "Informe um e-mail válido."

#: apps/accounts/staff_views.py:80
#, python-format
msgid ""
"%(email)s is a customer account. A team account cannot belong to an "
"organization or a brand: use another e-mail address."
msgstr ""
"%(email)s é uma conta de cliente. Uma conta da equipe não pode pertencer a "
"uma organização nem a uma marca: use outro e-mail."

#: apps/accounts/staff_views.py:87
#, python-format
msgid "%(email)s is now part of the team."
msgstr "%(email)s agora faz parte da equipe."

#: apps/accounts/staff_views.py:98
#, python-format
msgid "%(email)s was added. An e-mail to set the password was sent to them."
msgstr ""
"%(email)s foi adicionado. Um e-mail para definir a senha foi enviado a essa "
"pessoa."

#: apps/accounts/staff_views.py:105
#, python-format
msgid ""
"%(email)s was added, but the e-mail to set the password was not sent. Ask "
"them to use “Forgot your password?”."
msgstr ""
"%(email)s foi adicionado, mas o e-mail para definir a senha não foi enviado. "
"Peça para a pessoa usar “Esqueceu sua senha?”."

#: apps/accounts/staff_views.py:119 apps/accounts/staff_views.py:139
msgid "The team needs at least one active superadmin."
msgstr "A equipe precisa de pelo menos um superadmin ativo."

#: apps/accounts/staff_views.py:127
#, python-format
msgid "The level of %(email)s was changed."
msgstr "O nível de %(email)s foi alterado."

#: apps/accounts/staff_views.py:143
#, python-format
msgid "%(email)s was removed from the team."
msgstr "%(email)s foi removido da equipe."

#: apps/accounts/staff_views.py:147
#, python-format
msgid ""
"%(email)s left the team and is a customer account again, with its "
"organizations and brands."
msgstr ""
"%(email)s saiu da equipe e voltou a ser uma conta de cliente, com suas "
"organizações e marcas."

#: apps/accounts/views.py:98
msgid "Profile updated."
msgstr "Perfil atualizado."

