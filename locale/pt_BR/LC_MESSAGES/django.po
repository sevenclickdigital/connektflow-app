msgstr "Vídeos e Shorts"

#: apps/social_accounts/catalog.py:32
#: templates/onboarding/connection_page.html:100
msgid "Video content"
msgstr "Conteúdo em vídeo"

#: apps/social_accounts/catalog.py:33
#: templates/onboarding/connection_page.html:98
msgid "Personal profile"
msgstr "Perfil pessoal"

#: apps/social_accounts/catalog.py:34
#: templates/onboarding/connection_page.html:99
msgid "Company pages"
msgstr "Páginas de empresa"

#: apps/social_accounts/catalog.py:35
